DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=true
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# For MySQL, use DB_ENGINE=mysql and configure:
# DB_NAME=ecoenergy
# DB_USER=ecoenergy_user
# DB_PASSWORD=local-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Email configuration (Clase 6)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ecoenergy.local

# Password Reset Security settings
PASSWORD_RESET_CODE_TTL_SECONDS=120
PASSWORD_RESET_MAX_ATTEMPTS=5
